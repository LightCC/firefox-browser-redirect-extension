{
  "manifest_version": 2,
  "name": "Firefox Redirect URL",
  "version": "0.1.0",
  "description": "Open allowlisted SharePoint, OneDrive, and other web links in your selected browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-redirect-url@msl.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["rules.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Firefox Redirect URL settings",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
